{
  "data": {
    "batch_size": 64,
    "drop_incomplete_items": true,
    "max_claims": 4,
    "max_options": 6,
    "num_workers": 2,
    "option_feature_dim": 0,
    "pin_memory": true,
    "provenance": "real",
    "randomize_eval_order": true,
    "records_path": "runs/arms/records.persona_only_council.jsonl",
    "simulate_n_items": 4096,
    "simulate_seed": 20260726,
